// DAX measures of the Power BI model (generated by scripts/build_powerbi_project.py).
// All revenue measures count completed orders only (Sales[is_completed] = 1).

// Net line amounts (after discount) of completed orders  [folder: Sales; format: €#,0;-€#,0;€#,0]
[Net Sales] :=
    CALCULATE ( SUM ( Sales[net_amount] ), Sales[is_completed] = 1 )

// Quantity x unit price of completed orders, before discount  [folder: Sales; format: €#,0;-€#,0;€#,0]
[Gross Sales] :=
    CALCULATE ( SUM ( Sales[gross_amount] ), Sales[is_completed] = 1 )

// Discounts granted on completed orders  [folder: Sales; format: €#,0;-€#,0;€#,0]
[Discount Amount] :=
    CALCULATE ( SUM ( Sales[discount_amount] ), Sales[is_completed] = 1 )

// Completed orders  [folder: Volume; format: #,0]
[Orders] :=
    CALCULATE ( DISTINCTCOUNT ( Sales[order_id] ), Sales[is_completed] = 1 )

// Quantity of completed order lines  [folder: Volume; format: #,0]
[Units Sold] :=
    CALCULATE ( SUM ( Sales[quantity] ), Sales[is_completed] = 1 )

// Distinct customers with a completed order  [folder: Volume; format: #,0]
[Active Customers] :=
    CALCULATE ( DISTINCTCOUNT ( Sales[customer_id] ), Sales[is_completed] = 1 )

// Cancelled orders  [folder: Volume; format: #,0]
[Cancelled Orders] :=
    CALCULATE ( DISTINCTCOUNT ( Sales[order_id] ), Sales[is_completed] = 0 )

// Cancelled orders / all orders  [folder: Volume; format: 0.0%;-0.0%;0.0%]
[Cancellation Rate] :=
    DIVIDE ( [Cancelled Orders], [Orders] + [Cancelled Orders] )

// Net sales / orders  [folder: Sales; format: €#,0.00;-€#,0.00;€#,0.00]
[Average Order Value] :=
    DIVIDE ( [Net Sales], [Orders] )

// Net sales - quantity x catalog unit cost  [folder: Profitability; format: €#,0;-€#,0;€#,0]
[Gross Margin] :=
    CALCULATE ( SUM ( Sales[margin_amount] ), Sales[is_completed] = 1 )

// Gross margin / net sales  [folder: Profitability; format: 0.0%;-0.0%;0.0%]
[Gross Margin %] :=
    DIVIDE ( [Gross Margin], [Net Sales] )

// Discount amount / gross sales  [folder: Sales; format: 0.0%;-0.0%;0.0%]
[Discount Rate] :=
    DIVIDE ( [Discount Amount], [Gross Sales] )

// Net sales of the previous month (same filter context)  [folder: Comparisons; format: €#,0;-€#,0;€#,0]
[Net Sales PM] :=
    CALCULATE ( [Net Sales], DATEADD ( Calendar[full_date], -1, MONTH ) )

// Change versus the previous month  [folder: Comparisons; format: 0.0%;-0.0%;0.0%]
[MoM Growth %] :=
    DIVIDE ( [Net Sales] - [Net Sales PM], [Net Sales PM] )

// Net sales of the same period one year earlier  [folder: Comparisons; format: €#,0;-€#,0;€#,0]
[Net Sales PY] :=
    CALCULATE ( [Net Sales], SAMEPERIODLASTYEAR ( Calendar[full_date] ) )

// Change versus the same period one year earlier  [folder: Comparisons; format: 0.0%;-0.0%;0.0%]
[YoY Growth %] :=
    DIVIDE ( [Net Sales] - [Net Sales PY], [Net Sales PY] )

// Year-to-date net sales  [folder: Comparisons; format: €#,0;-€#,0;€#,0]
[Net Sales YTD] :=
    TOTALYTD ( [Net Sales], Calendar[full_date] )

// Growth of the last selected month versus the month before  [folder: Comparisons; format: 0.0%;-0.0%;0.0%]
[Latest Month MoM %] :=
    VAR LastMonth = CALCULATE ( MAX ( Calendar[month_key] ), ALLSELECTED ( Calendar ) ) RETURN CALCULATE ( [MoM Growth %], Calendar[month_key] = LastMonth )

// Growth of the last selected month versus the same month one year earlier  [folder: Comparisons; format: 0.0%;-0.0%;0.0%]
[Latest Month YoY %] :=
    VAR LastMonth = CALCULATE ( MAX ( Calendar[month_key] ), ALLSELECTED ( Calendar ) ) RETURN CALCULATE ( [YoY Growth %], Calendar[month_key] = LastMonth )

// Share of the net sales of all categories (other filters kept)  [folder: Sales; format: 0.0%;-0.0%;0.0%]
[Category Share %] :=
    DIVIDE ( [Net Sales], CALCULATE ( [Net Sales], ALL ( Product[category] ) ) )

// Rank of the product by net sales within the current selection  [folder: Sales; format: 0]
[Product Rank] :=
    IF ( NOT ISBLANK ( [Net Sales] ), RANKX ( ALLSELECTED ( Product[product_name] ), [Net Sales] ) )

// Source rows excluded by the pipeline (each with its reason)  [folder: Data quality; format: #,0]
[Rejected Rows] :=
    COUNTROWS ( 'Rejected Rows' ) + 0

// Quality and reconciliation checks that passed in the last run  [folder: Data quality; format: #,0]
[Checks Passed] :=
    COUNTROWS ( FILTER ( 'Quality Checks', 'Quality Checks'[passed] = "true" ) ) + 0

// Checks that failed (a published run always has 0)  [folder: Data quality; format: #,0]
[Checks Failed] :=
    COUNTROWS ( FILTER ( 'Quality Checks', 'Quality Checks'[passed] = "false" ) ) + 0
