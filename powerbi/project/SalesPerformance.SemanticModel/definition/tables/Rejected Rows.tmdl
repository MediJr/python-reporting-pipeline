	partition 'Rejected Rows' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\rejected_rows.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"source_table", type text}, {"source_line", Int64.Type}, {"reason", type text}, {"column_name", type text}, {"message", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
