table Sales
	lineageTag: 5e30b2b7-e4e7-5a2f-af93-6386c1f1c9aa

	/// Net line amounts (after discount) of completed orders
	measure 'Net Sales' = CALCULATE ( SUM ( Sales[net_amount] ), Sales[is_completed] = 1 )
		formatString: €#,0;-€#,0;€#,0
		displayFolder: Sales
		lineageTag: 36092060-beec-5591-8e38-1d5c12d56f49

	/// Quantity x unit price of completed orders, before discount
	measure 'Gross Sales' = CALCULATE ( SUM ( Sales[gross_amount] ), Sales[is_completed] = 1 )
		formatString: €#,0;-€#,0;€#,0
		displayFolder: Sales
		lineageTag: af3a91c9-b3e6-5d1c-ba70-c61281e35e8e

	/// Discounts granted on completed orders
	measure 'Discount Amount' = CALCULATE ( SUM ( Sales[discount_amount] ), Sales[is_completed] = 1 )
		formatString: €#,0;-€#,0;€#,0
		displayFolder: Sales
		lineageTag: dc5afe9b-071f-55c6-80c6-1801fbb9d348

	/// Completed orders
	measure 'Orders' = CALCULATE ( DISTINCTCOUNT ( Sales[order_id] ), Sales[is_completed] = 1 )
		formatString: #,0
		displayFolder: Volume
		lineageTag: a5582a4c-d563-503b-8964-4b2cbdc5af7e

	/// Quantity of completed order lines
	measure 'Units Sold' = CALCULATE ( SUM ( Sales[quantity] ), Sales[is_completed] = 1 )
		formatString: #,0
		displayFolder: Volume
		lineageTag: fba975a3-23a5-5025-830d-72fc2d9a2617

	/// Distinct customers with a completed order
	measure 'Active Customers' = CALCULATE ( DISTINCTCOUNT ( Sales[customer_id] ), Sales[is_completed] = 1 )
		formatString: #,0
		displayFolder: Volume
		lineageTag: a3d4a6ad-3fbd-50df-af48-8d620abd0a53

	/// Cancelled orders
	measure 'Cancelled Orders' = CALCULATE ( DISTINCTCOUNT ( Sales[order_id] ), Sales[is_completed] = 0 )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 7b8b5f39-5a2e-5d56-a6b1-5fa1c83a19da

	/// Cancelled orders / all orders
	measure 'Cancellation Rate' = DIVIDE ( [Cancelled Orders], [Orders] + [Cancelled Orders] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Volume
		lineageTag: a214facf-1270-5278-ab2f-5949d5412a3f

	/// Net sales / orders
	measure 'Average Order Value' = DIVIDE ( [Net Sales], [Orders] )
		formatString: €#,0.00;-€#,0.00;€#,0.00
		displayFolder: Sales
		lineageTag: 98686e59-36f8-59c9-8f9b-b8888e9dfeb3

	/// Net sales - quantity x catalog unit cost
	measure 'Gross Margin' = CALCULATE ( SUM ( Sales[margin_amount] ), Sales[is_completed] = 1 )
		formatString: €#,0;-€#,0;€#,0
		displayFolder: Profitability
		lineageTag: 65d6231d-906a-58fb-830c-e3c301b8610d

	/// Gross margin / net sales
	measure 'Gross Margin %' = DIVIDE ( [Gross Margin], [Net Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Profitability
		lineageTag: ee8894fb-bcfd-53cb-85a0-a96d852b4ad8

	/// Discount amount / gross sales
	measure 'Discount Rate' = DIVIDE ( [Discount Amount], [Gross Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Sales
		lineageTag: 93987e5a-4f4f-51af-8e59-937eec9c0a3d

	/// Net sales of the previous month (same filter context)
	measure 'Net Sales PM' = CALCULATE ( [Net Sales], DATEADD ( Calendar[full_date], -1, MONTH ) )
		formatString: €#,0;-€#,0;€#,0
		displayFolder: Comparisons
		lineageTag: 0ff3521f-77f1-5c65-9e33-62941f169fa6

	/// Change versus the previous month
	measure 'MoM Growth %' = DIVIDE ( [Net Sales] - [Net Sales PM], [Net Sales PM] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Comparisons
		lineageTag: c413db83-91c3-5d51-82a0-1a1354c1c1ec

	/// Net sales of the same period one year earlier
	measure 'Net Sales PY' = CALCULATE ( [Net Sales], SAMEPERIODLASTYEAR ( Calendar[full_date] ) )
		formatString: €#,0;-€#,0;€#,0
		displayFolder: Comparisons
		lineageTag: 87ba65ff-f3a8-53c6-b798-0d174a2ab2ce

	/// Change versus the same period one year earlier
	measure 'YoY Growth %' = DIVIDE ( [Net Sales] - [Net Sales PY], [Net Sales PY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Comparisons
		lineageTag: 4cadf9dc-6da7-506d-b84f-c7d14c80ed56

	/// Year-to-date net sales
	measure 'Net Sales YTD' = TOTALYTD ( [Net Sales], Calendar[full_date] )
		formatString: €#,0;-€#,0;€#,0
		displayFolder: Comparisons
		lineageTag: b0c5230e-e126-5b80-b4a2-611bca4f2d6c

	/// Growth of the last selected month versus the month before
	measure 'Latest Month MoM %' = VAR LastMonth = CALCULATE ( MAX ( Calendar[month_key] ), ALLSELECTED ( Calendar ) ) RETURN CALCULATE ( [MoM Growth %], Calendar[month_key] = LastMonth )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Comparisons
		lineageTag: 707a56df-6ab4-5a32-bc44-acf157d6b3fd

	/// Growth of the last selected month versus the same month one year earlier
	measure 'Latest Month YoY %' = VAR LastMonth = CALCULATE ( MAX ( Calendar[month_key] ), ALLSELECTED ( Calendar ) ) RETURN CALCULATE ( [YoY Growth %], Calendar[month_key] = LastMonth )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Comparisons
		lineageTag: 79202f10-9f6d-5f24-98f9-3032acd1b327

	/// Share of the net sales of all categories (other filters kept)
	measure 'Category Share %' = DIVIDE ( [Net Sales], CALCULATE ( [Net Sales], ALL ( Product[category] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Sales
		lineageTag: 9d6d50fa-de65-598d-9fed-3ca2cb1f4573

	/// Rank of the product by net sales within the current selection
	measure 'Product Rank' = IF ( NOT ISBLANK ( [Net Sales] ), RANKX ( ALLSELECTED ( Product[product_name] ), [Net Sales] ) )
		formatString: 0
		displayFolder: Sales
		lineageTag: be2d7237-9a48-595d-955b-0e50f0c0e23e

	/// Source rows excluded by the pipeline (each with its reason)
	measure 'Rejected Rows' = COUNTROWS ( 'Rejected Rows' ) + 0
		formatString: #,0
		displayFolder: Data quality
		lineageTag: 53a8081a-3dd7-50bf-a76e-2298b0d5d300

	/// Quality and reconciliation checks that passed in the last run
	measure 'Checks Passed' = COUNTROWS ( FILTER ( 'Quality Checks', 'Quality Checks'[passed] = "true" ) ) + 0
		formatString: #,0
		displayFolder: Data quality
		lineageTag: 530a562a-a479-5116-b477-e7c8c806eaa4

	/// Checks that failed (a published run always has 0)
	measure 'Checks Failed' = COUNTROWS ( FILTER ( 'Quality Checks', 'Quality Checks'[passed] = "false" ) ) + 0
		formatString: #,0
		displayFolder: Data quality
		lineageTag: 55b5728a-3e14-5896-8e89-05c983d82ff0

