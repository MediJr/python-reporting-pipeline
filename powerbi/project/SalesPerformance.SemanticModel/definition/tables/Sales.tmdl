	partition Sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\fact_sales.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"order_id", type text}, {"line_number", Int64.Type}, {"date_key", Int64.Type}, {"order_date", type date}, {"product_id", type text}, {"customer_id", type text}, {"customer_segment", type text}, {"region", type text}, {"sales_channel", type text}, {"order_status", type text}, {"is_completed", Int64.Type}, {"quantity", Int64.Type}, {"unit_price", Currency.Type}, {"discount_rate", type number}, {"gross_amount", Currency.Type}, {"discount_amount", Currency.Type}, {"net_amount", Currency.Type}, {"cost_amount", Currency.Type}, {"margin_amount", Currency.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
