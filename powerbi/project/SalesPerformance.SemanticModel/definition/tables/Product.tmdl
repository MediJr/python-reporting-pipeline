	partition Product = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\dim_product.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"product_id", type text}, {"product_name", type text}, {"category", type text}, {"unit_cost", Currency.Type}, {"list_price", Currency.Type}, {"launch_date", type date}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
